<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="watch.rist.assistant"
    android:versionCode="482"
    android:versionName="0.2.0">

    <queries>
        <intent><action android:name="android.media.action.STILL_IMAGE_CAMERA" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <package android:name="app.grapheneos.camera" />
        <package android:name="com.android.gallery3d" />
        <package android:name="com.android.dialer" />
        <package android:name="com.android.messaging" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.contacts" />
    </queries>

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A video call's audio through a Bluetooth headset; the web engine needs it to use one. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <permission
        android:name="watch.rist.assistant.permission.OTA_WAKE"
        android:protectionLevel="signature" />
    <uses-permission android:name="watch.rist.assistant.permission.OTA_WAKE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="com.android.voicemail.permission.ADD_VOICEMAIL" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SYSTEM_APPLICATION_OVERLAY" />

    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- SCHEDULE_EXACT_ALARM must not be declared here unless it is also added to
         aosp/sysconfig/rist-privapp-permissions-watch.rist.assistant.xml in the same release. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <!-- Voice replies play on the assistant volume, which Android lets only a privileged caller
         set; without it every Voice slider change is refused. Listed in the privapp allowlist too. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS_PRIVILEGED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RistAssistant"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RistAssistant"
            android:screenOrientation="portrait"
            android:lockTaskMode="if_whitelisted"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/setup_title"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RistAssistant" />

        <activity
            android:name=".NetworkLocationPromptActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:lockTaskMode="if_whitelisted"
            android:theme="@style/Theme.RistAssistant" />

        <activity
            android:name=".BackgroundLocationPromptActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:lockTaskMode="if_whitelisted"
            android:theme="@style/Theme.RistAssistant" />

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RistAssistant" />

        <!-- The site a scanned QR code points at, and nowhere else. Never exported: the only way
             in is a link RIST itself has just read and the person has just agreed to open. -->
        <activity
            android:name=".LockedBrowserActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RistAssistant" />

        <!-- Video calls. The join screen is the confirmation: nothing loads and no camera opens
             before its Join is tapped. Neither is exported; the call browser is opened only by
             the join screen, and only on a host it holds its own list of. -->
        <activity
            android:name=".VideoCallJoinActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RistAssistant" />

        <activity
            android:name=".CallBrowserActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RistAssistant" />

        <!-- A call link is a credential: no usage metrics leave the web engine. -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <!-- The caption screen between choosing a photo and sending it. -->
        <activity
            android:name=".PhotoComposeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RistAssistant" />

        <service
            android:name=".OverlayHomeService"
            android:exported="false" />

        <service
            android:name=".RecordService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />

        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />


        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <service
            android:name=".PushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The action is a protected broadcast registered in the AOSP overlay. -->
        <receiver
            android:name=".KeyEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="watch.rist.assistant.action.RECORD_DOWN" />
                <action android:name="watch.rist.assistant.action.RECORD_UP" />
            </intent-filter>
        </receiver>

        <!-- Component name must match aosp Provision's tmp_provision_receiver. -->
        <receiver
            android:name=".RistDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.ACTION_PASSWORD_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".RistVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".RistVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="false" />
    
        <service
            android:name=".RistNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity android:name=".VoicemailActivity" android:exported="false" />

        <!-- Empty taskAffinity + singleInstance keep this out of the home task; Rist is HOME. -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- Lets the system camera write one capture into our cache and nothing else. The
             authority is spelled out rather than templated: Soong does not substitute
             ${applicationId}, and this manifest is built by both Gradle and Soong. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="watch.rist.assistant.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Hourly check that the clock's time zone still matches where the phone is. -->
        <receiver android:name=".TimeZoneCheckReceiver" android:exported="false" />

        <receiver android:name=".AlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".GeofenceAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A .PhoneStateReceiver was declared here with a PHONE_STATE filter, and the class
             does not exist anywhere: not in the tree, not in history, not in the box backup.
             Every call therefore crashed the app before it could do anything, because Android
             instantiates a declared receiver when its action fires. It was presumably meant to
             call IncomingCall.show(), which still has no callers. Removed rather than stubbed:
             a receiver that does nothing is not worth waking the process for. Restoring caller
             ID means writing that class deliberately. -->

        <!-- android:process=":ota" is matched by the seapp_contexts entry in aosp/sepolicy/; do not remove. -->
        <service
            android:name=".OtaService"
            android:exported="false"
            android:process=":ota"
            android:foregroundServiceType="systemExempted" />

        <!-- No android:process on purpose: OtaState (SharedPreferences) is written only in the main process. -->
        <receiver
            android:name=".OtaResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".OtaAlarmReceiver"
            android:exported="true"
            android:permission="watch.rist.assistant.permission.OTA_WAKE">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
